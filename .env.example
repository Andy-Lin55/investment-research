# ============================================================
# Investment Research System — Environment Variables
# ============================================================
# ⚠️  NEVER commit the actual .env file to git
# Copy this to .env and fill in real values

# Notion
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_UNIVERSE_DB_ID=0f3641457af782b6895b01874689e969
NOTION_EVENTS_DB_ID=6ff641457af78233821c01e2885a3d6b
NOTION_RESEARCH_DB_ID=07b641457af782c19481013c92293be2
NOTION_RESEARCH_HISTORY_DB_ID=5c5641457af782528a968143cdd78757

# Tushare
TUSHARE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Finnhub
FINNHUB_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DMXAPI (OpenAI-compatible). The key must belong to the selected site.
# CN: https://www.dmxapi.cn/v1; COM: https://www.dmxapi.com/v1
# SSVIP: https://ssvip.dmxapi.com/v1
DMXAPI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DMXAPI_BASE_URL=https://www.dmxapi.cn/v1
# Use a model ID available to your DMXAPI account; check the site's model list.
DMXAPI_MODEL=gemini-3.8-flash

# 飞书 Webhook（可选，配置后简报优先走飞书）
FEISHU_WEBHOOK=

# 每日简报 SMTP（可选，境外环境替代 Apple Mail）
# Gmail 用法：smtp.gmail.com:465，需在 Google 账号设置里生成"应用专用密码"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
BRIEFING_FROM_EMAIL=

# Google Gemini
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
