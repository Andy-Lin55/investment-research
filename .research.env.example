# Copy to .research.env (ignored). Never commit real values.
HOLDINGS_RESEARCH_ENABLED=false
NOTION_TOKEN=
RESEARCH_UNIVERSE_SOURCE_ID=
RESEARCH_NOTION_TASKS_SOURCE_ID=
RESEARCH_NOTION_REPORTS_SOURCE_ID=
RESEARCH_REGISTRY_FILE=
# Cloud uses a private RESEARCH_ISSUERS_JSON GitHub secret instead.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TOKEN_CACHE=
# Use an existing private directory + reserved filename .research-graph-token.json.
# GitHub uses ONEDRIVE_REFRESH_TOKEN and a fine-grained RESEARCH_GITHUB_TOKEN
# restricted to this repository and Actions secrets write for token rotation.
DMXAPI_KEY=
GEMINI_API_KEY=
RESEARCH_DMX_MODEL=gemini-3.8-flash
# Confirm account/group pricing in CNY per 1 million tokens. Blank blocks calls.
RESEARCH_DMX_INPUT_CNY_PER_MILLION=
RESEARCH_DMX_OUTPUT_CNY_PER_MILLION=
RESEARCH_GEMINI_INPUT_CNY_PER_MILLION=
RESEARCH_GEMINI_OUTPUT_CNY_PER_MILLION=
RESEARCH_OFFICIAL_FEEDS_JSON=[]
SEC_USER_AGENT=
# Budget is fixed by Budget defaults: task CNY2 / Beijing day CNY10 / month CNY100.
