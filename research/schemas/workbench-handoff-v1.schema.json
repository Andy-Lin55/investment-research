{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.example.invalid/schemas/workbench-handoff-v1.schema.json",
  "title": "Workbench → Holdings research handoff v1.x",
  "type": "object",
  "required": ["schema_version", "handoff_id", "issuer_id", "securities", "producer", "knowledge_cutoff", "parent_handoff_id", "research_question", "theses", "forecasts", "valuation", "disagreements", "monitoring", "source_index", "artifacts", "gaps", "review_status"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "handoff_id": {"$ref": "#/$defs/id"},
    "issuer_id": {"type": "string", "minLength": 1},
    "securities": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["market", "ticker", "currency", "share_class"], "properties": {"market": {"type": "string", "minLength": 1}, "ticker": {"type": "string", "minLength": 1}, "currency": {"type": "string", "minLength": 1}, "share_class": {"type": "string", "minLength": 1}}}},
    "producer": {"type": "object", "required": ["project", "run_id", "git_commit", "created_at"], "properties": {"project": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "git_commit": {"type": "string", "minLength": 1}, "created_at": {"$ref": "#/$defs/timestamp"}}},
    "knowledge_cutoff": {"$ref": "#/$defs/timestamp"},
    "parent_handoff_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "research_question": {"type": "string", "minLength": 1},
    "theses": {"type": "array", "items": {"type": "object", "required": ["thesis_id", "claim", "driver", "falsifier", "status", "evidence_refs"], "properties": {"thesis_id": {"$ref": "#/$defs/id"}, "claim": {"type": "string", "minLength": 1}, "driver": {"type": "string", "minLength": 1}, "falsifier": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "research_assumption": {"type": ["string", "null"]}, "evidence_refs": {"$ref": "#/$defs/refs"}}}},
    "forecasts": {"type": "array", "items": {"type": "object", "required": ["metric", "period_start", "period_end", "period_basis", "value", "currency", "unit_scale", "scope", "ownership_basis", "origin", "scenario", "source_refs"], "properties": {"metric": {"type": "string", "minLength": 1}, "period_start": {"$ref": "#/$defs/day"}, "period_end": {"$ref": "#/$defs/day"}, "period_basis": {"enum": ["annual", "year_to_date", "quarter", "instant"]}, "value": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]}, "currency": {"type": "string", "minLength": 1}, "unit_scale": {"$ref": "#/$defs/decimal"}, "scope": {"type": "string", "minLength": 1}, "ownership_basis": {"type": "string", "minLength": 1}, "origin": {"enum": ["reported_actual", "management_guidance", "broker_forecast", "research_assumption", "calculated"]}, "scenario": {"type": "string", "minLength": 1}, "source_refs": {"$ref": "#/$defs/refs"}}}},
    "valuation": {"type": ["object", "null"], "properties": {"source_refs": {"$ref": "#/$defs/refs"}}},
    "disagreements": {"type": "array", "items": {"type": "object", "properties": {"source_refs": {"$ref": "#/$defs/refs"}}}},
    "monitoring": {"type": "array", "items": {"type": "object", "required": ["condition", "due_date", "verification", "action"], "properties": {"question_id": {"$ref": "#/$defs/id"}, "metric_id": {"$ref": "#/$defs/id"}, "condition": {"type": "string", "minLength": 1}, "due_date": {"$ref": "#/$defs/day"}, "verification": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}}, "anyOf": [{"required": ["question_id"]}, {"required": ["metric_id"]}]}},
    "source_index": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "revision_id", "category", "published_at", "version_summary", "locator", "storage_uri"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "category": {"type": "string", "minLength": 1}, "published_at": {"$ref": "#/$defs/timestamp"}, "version_summary": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "storage_uri": {"type": "string", "minLength": 1}}}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["role", "uri", "sha256"], "properties": {"role": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["missing", "impact", "needed_evidence"], "properties": {"missing": {"type": "string", "minLength": 1}, "impact": {"type": "string", "minLength": 1}, "needed_evidence": {"type": "string", "minLength": 1}}}},
    "review_status": {"enum": ["candidate", "accepted", "rejected"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "day": {"type": "string", "format": "date"},
    "timestamp": {"type": "string", "format": "date-time"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
